{
  "schemaVersion": "1.0",
  "suite": "compare-extended",
  "version": 1,
  "description": "Custom multi-capability Agent comparison set.",
  "cases": [
    {
      "id": "extended.docs.merge",
      "query": "Read docs/a.md and docs/b.md. Combine the architecture family and number into the form ARCH-<number>. Reply exactly RESULT: ARCH-42.",
      "workspace": {"template": "workspaces/extended"},
      "expected": {"finalContains": ["RESULT: ARCH-42"]},
      "budgets": {"maxWallMs": 180000, "maxTotalTokens": 150000, "maxToolCalls": 20},
      "network": {"mode": "deny", "hosts": []},
      "metadata": {"taskType": "grounded-read", "risk": "low"}
    },
    {
      "id": "extended.docs.precedence",
      "query": "Read docs/precedence.md, config/service.yaml, and config/override.env. Determine the effective timeout. Reply exactly RESULT: 45s.",
      "workspace": {"template": "workspaces/extended"},
      "expected": {"finalContains": ["RESULT: 45s"]},
      "budgets": {"maxWallMs": 180000, "maxTotalTokens": 150000, "maxToolCalls": 20},
      "network": {"mode": "deny", "hosts": []},
      "metadata": {"taskType": "configuration", "risk": "low"}
    },
    {
      "id": "extended.docs.long",
      "query": "Read docs/long.md and find the unique marker that starts with NEEDLE-. Reply exactly RESULT: NEEDLE-731.",
      "workspace": {"template": "workspaces/extended"},
      "expected": {"finalContains": ["RESULT: NEEDLE-731"]},
      "budgets": {"maxWallMs": 180000, "maxTotalTokens": 150000, "maxToolCalls": 20},
      "network": {"mode": "deny", "hosts": []},
      "metadata": {"taskType": "long-context", "risk": "low"}
