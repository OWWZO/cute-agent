      "workspace": {"template": "workspaces/extended"},
      "expected": {
        "finalContains": ["DONE"],
        "workspaceChecks": [
          {"path": "src/app.py", "contains": ["def new_name", "new_name(41)"], "notContains": ["old_name"]}
        ]
      },
      "budgets": {"maxWallMs": 180000, "maxTotalTokens": 150000, "maxToolCalls": 30},
      "network": {"mode": "deny", "hosts": []},
      "metadata": {"taskType": "code-edit", "risk": "medium"}
