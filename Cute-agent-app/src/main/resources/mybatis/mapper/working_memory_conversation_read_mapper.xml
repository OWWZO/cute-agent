<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.wwz.ai.infrastructure.dao.cute.IWorkingMemoryConversationReadDao">

    <resultMap id="WorkingMemoryConversationRowMap"
               type="org.wwz.ai.domain.agent.ledger.model.WorkingMemoryConversationRow">
        <result column="turn_id" property="turnId"/>
        <result column="message_id" property="messageId"/>
        <result column="session_id" property="sessionId"/>
        <result column="request_id" property="requestId"/>
        <result column="run_id" property="runId"/>
        <result column="turn_seq" property="turnSeq"/>
        <result column="seq_no" property="seqNo"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="tool_call_id" property="toolCallId"/>
        <result column="tool_calls_json" property="toolCallsJson"/>
        <result column="message_kind" property="messageKind"/>
        <result column="visibility" property="visibility"/>
        <result column="token_estimate" property="tokenEstimate"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="queryBySessionIds" resultMap="WorkingMemoryConversationRowMap">
        SELECT t.id AS turn_id,
               m.id AS message_id,
               t.session_id,
               t.request_id,
               t.run_id,
               t.turn_seq,
               m.seq_no,
               m.role,
               m.content,
               m.tool_call_id,
               m.tool_calls_json,
               m.message_kind,
               m.visibility,
               m.token_estimate,
               m.create_time
        FROM ai_agent_working_memory_turn t
        INNER JOIN ai_agent_working_memory_message m
                ON m.turn_id = t.id
               AND m.deleted = 0
        WHERE t.session_id IN
        <foreach collection="sessionIds" item="sessionId"
                 open="(" separator="," close=")">
            #{sessionId}
        </foreach>
          AND t.memory_scope = 'main'
          AND m.memory_scope = 'main'
          AND t.deleted = 0
          AND (m.visibility IS NULL OR m.visibility &lt;&gt; 'MODEL_ONLY')
        ORDER BY t.session_id ASC, t.turn_seq ASC, m.seq_no ASC, m.id ASC
    </select>

</mapper>
